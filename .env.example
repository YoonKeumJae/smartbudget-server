# Copy to .env; never commit a real signing key.
# Generate: .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_ISSUER=accountbook
JWT_AUDIENCE=accountbook-api
TOKEN_SECONDS=432000
DATABASE_PATH=./data/accountbook.sqlite3
HOST=127.0.0.1
PORT=8000
# JSON array of exact origins, e.g. ["http://localhost:3000"]
WEB_ORIGINS=[]
